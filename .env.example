# Database: local SQLite by default; use libsql://... for Turso/libSQL.
DATABASE_URL=file:./local.db
# Remote database token, if required. Not needed for a local file.
DATABASE_AUTH_TOKEN=

# Generate a strong random secret before starting the app (openssl rand -hex 32).
BETTER_AUTH_SECRET=
# Public authentication origin; use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000
# Public origin used for signing links and completion emails.
APP_URL=http://localhost:3000

# Optional root/admin secret for POST /api/accounts and /api/keys bootstrap.
# Generate a strong random key. Give agents provisioned regular database keys.
# The owner ID is optional for bootstrap, required for root document requests.
NIMMARI_API_KEY=
NIMMARI_API_OWNER_ID=
# Service user creation script defaults; CLI email/name take precedence.
SERVICE_USER_EMAIL=
SERVICE_USER_NAME=Service Account

# Optional email delivery. Leave both empty to distribute signing links manually.
RESEND_API_KEY=
# Use an address on your verified sending domain, e.g. Nimmari <noreply@example.com>.
RESEND_FROM=
# Optional signing secret for POST /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# System Chrome/Chromium path for HTML-to-PDF rendering outside serverless hosts.
# Example on Linux: /usr/bin/chromium. macOS Chrome is the code's fallback.
PUPPETEER_EXECUTABLE_PATH=
# Platform-managed detection flags: leave unset locally. Nonempty values select
# @sparticuz/chromium-min, which downloads its pinned Chromium pack at runtime.
VERCEL=
AWS_LAMBDA_FUNCTION_NAME=
# Smoke script target (optional; defaults to this URL).
HOST=http://localhost:3000

# Optional document audit timezone and outbound webhook HMAC secret
NIMMARI_AUDIT_TIMEZONE=Europe/Helsinki
NIMMARI_WEBHOOK_SECRET=

# Optional signing GET diagnostics: 1 enables count and 8-hex IP bucket key headers.
# Disabled by default; never exposes raw IP addresses.
NIMMARI_RATE_LIMIT_DEBUG=0

# Optional one-time first-account bootstrap (32+ characters). Legacy: PUUMERKKI_SETUP_CODE
NIMMARI_SETUP_CODE=

# DB-backed webhook poller (Docker defaults to 1; serverless should use cron).
NIMMARI_WEBHOOK_WORKER=0
# Trusted local/private webhook destinations only; leave disabled for public deployments.
NIMMARI_WEBHOOK_ALLOW_PRIVATE=0
